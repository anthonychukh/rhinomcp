{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gh_trigger_button.json",
  "title": "gh_trigger_button",
  "description": "Momentarily press a standard Grasshopper Button component and solve on press and release.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instance_id": { "$ref": "#/$defs/guid" },
    "nickname": { "type": "string", "minLength": 1 },
    "alias": { "type": "string", "minLength": 1 }
  },
  "oneOf": [
    { "required": ["instance_id"] },
    { "required": ["nickname"] },
    { "required": ["alias"] }
  ],
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
