{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gh_set_toggle.json",
  "title": "gh_set_toggle",
  "description": "Set a standard Grasshopper Boolean Toggle, or invert its current state when value is omitted.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instance_id": { "$ref": "#/$defs/guid" },
    "nickname": { "type": "string", "minLength": 1 },
    "alias": { "type": "string", "minLength": 1 },
    "value": { "type": "boolean" },
    "recompute": { "type": "boolean", "default": true }
  },
  "oneOf": [
    { "required": ["instance_id"] },
    { "required": ["nickname"] },
    { "required": ["alias"] }
  ],
  "$defs": {
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
